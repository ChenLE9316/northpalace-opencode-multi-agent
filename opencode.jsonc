{
  "$schema": "https://opencode.ai/config.json",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
  "default_agent": "build",
  "subagent_depth": 2,
  "model": "opencode/x-preview-f-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "eslint": {
      "command": ["vscode-eslint-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".vue"]
    },
    "taplo": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "**/.local/share/opencode/auth.json": "deny",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      ".npmrc": "deny",
      "**/.npmrc": "deny",
      ".git-credentials": "deny",
      "**/.git-credentials": "deny",
      ".aws/**": "deny",
      "**/.aws/**": "deny",
      ".azure/**": "deny",
      "**/.azure/**": "deny",
      ".config/gcloud/**": "deny",
      "**/.config/gcloud/**": "deny",
      ".config/gh/**": "deny",
      "**/.config/gh/**": "deny",
      ".kube/**": "deny",
      "**/.kube/**": "deny",
      ".docker/config.json": "deny",
      "**/.docker/config.json": "deny",
      ".netrc": "deny",
      "**/.netrc": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "credentials.json": "deny",
      "**/credentials.json": "deny",
      "service-account*.json": "deny",
      "**/service-account*.json": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git branch --show-current*": "allow",
      "git remote -v*": "allow",
      "git remote get-url*": "allow",
      "git describe*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout --*": "deny",
      "git restore*": "deny",
      "gh pr merge*": "deny",
      "gh release create*": "deny",
      "gh release delete*": "deny",
      "gh repo delete*": "deny",
      "docker push*": "deny",
      "kubectl apply*": "deny",
      "kubectl delete*": "deny",
      "helm upgrade*": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "powershell*Remove-Item*": "deny",
      "cmd *del *": "deny",
      "cargo clean*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "bun publish*": "deny",
      "cargo publish*": "deny"
    },
    "task": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "playwright_*": "allow",
    "playwright_browser_run_code_unsafe": "deny",
    "playwright_browser_file_upload": "deny",
    "playwright_browser_drop": "deny",
    "playwright_browser_evaluate": "deny",
    "context7_*": "allow",
    "cua-driver_*": "deny",
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/rules/**": "allow",
      "~/.config/opencode/knowledge/**": "allow",
      "~/.config/opencode/decisions/**": "allow",
      "~/.config/opencode/handoffs/**": "allow"
    },
    "doom_loop": "ask",
    "skill": {
      "*": "allow",
      "northpalace-langfei-ni-token": "deny"
    },
    "question": "allow"
  },
  "agent": {
    "build": {
      "description": "Primary implementation agent for scoped changes, specialist delegation, and evidence-backed verification.",
      "mode": "primary",
      "prompt": "{file:./prompts/build.md}",
      "steps": 200,
      "reasoningEffort": "high",
      "color": "#5E8CFF",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "architect": "allow",
          "researcher": "allow",
          "review": "allow",
          "security-auditor": "allow",
          "error-analyzer": "allow",
          "dependency-checker": "allow",
          "agent-orchestrator": "allow",
          "frontend-engineer": "allow",
          "rust-engineer": "allow",
          "tauri-engineer": "allow",
          "electron-engineer": "allow",
          "test-runner": "allow",
          "release-manager": "allow",
          "knowledge-curator": "allow",
          "handoff-drafter": "allow",
          "e2e-tester": "allow"
        },
        "cua-driver_*": "ask",
        "websearch": "allow"
      }
    },
    "plan": {
      "description": "Hard source-edit read-only primary agent for architecture, risk analysis, and implementation planning.",
      "mode": "primary",
      "prompt": "{file:./prompts/plan.md}",
      "steps": 100,
      "reasoningEffort": "max",
      "color": "#A78BFA",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status --short": "allow",
          "git status --porcelain": "allow",
          "git diff --name-only": "allow",
          "git diff --stat": "allow",
          "git rev-parse HEAD": "allow",
          "git ls-files": "allow",
          "git branch --show-current": "allow",
          "git describe": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "planning-agent": "allow",
          "product-manager": "allow",
          "researcher": "allow",
          "api-designer": "allow",
          "ui-designer": "allow",
          "a11y-specialist": "allow",
          "security-auditor": "allow",
          "screen-context-agent": "allow",
          "dependency-checker": "allow",
          "error-analyzer": "allow",
          "discussion-facilitator": "allow",
          "multi-angle-researcher": "allow",
          "decision-analyst": "allow",
          "architect": "allow",
          "review": "allow",
          "handoff-drafter": "allow"
        },
        "cua-driver_*": "deny",
        "external_directory": "ask",
        "websearch": "allow"
      }
    },
    "explore": {
      "description": "Fast codebase exploration using local search, LSP, and evidence collection.",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "steps": 60,
      "reasoningEffort": "low",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "deny"
      },
      "prompt": "You are the explore agent: fast, read-only codebase exploration using glob / grep / LSP / local search. Always answer as the explore agent; never claim to be another agent or model. If you need clarification to proceed, surface the question in your text reply and never invoke the `question` tool; the parent agent will answer and the session will continue. "
    },
    "general": {
      "description": "General-purpose implementation subagent for bounded delegated tasks.",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "steps": 90,
      "reasoningEffort": "medium",
      "prompt": "You are the general subagent: bounded delegated implementation work using the smallest coherent change. Always answer as the general subagent; never claim to be another agent or model. If you need clarification to proceed, surface the question in your text reply and never invoke the `question` tool; the parent agent will answer and the session will continue. ",
      "permission": {
        "task": "deny",
        "question": "deny"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.78"
      ],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@3.2.5"
      ],
      "enabled": true
    },
    "cua-driver": {
      "type": "local",
      "command": [
        "cua-driver",
        "mcp"
      ],
      "environment": {
        "CUA_DRIVER_RS_TELEMETRY_ENABLED": "0"
      },
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "**/target/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/coverage/**",
      "**/.git/**"
    ]
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 5,
    "preserve_recent_tokens": 8000,
    "reserved": 12000
  },
  "shell": "bash"
}