{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "northpace",
  "subagent_depth": 3,
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "~/.local/share/opencode/auth.json": "deny",
      "**/.local/share/opencode/auth.json": "deny",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      ".npmrc": "deny",
      "**/.npmrc": "deny",
      ".git-credentials": "deny",
      "**/.git-credentials": "deny",
      ".aws/**": "deny",
      "**/.aws/**": "deny",
      ".azure/**": "deny",
      "**/.azure/**": "deny",
      ".config/gcloud/**": "deny",
      "**/.config/gcloud/**": "deny",
      ".config/gh/**": "deny",
      "**/.config/gh/**": "deny",
      ".kube/**": "deny",
      "**/.kube/**": "deny",
      ".docker/config.json": "deny",
      "**/.docker/config.json": "deny",
      ".netrc": "deny",
      "**/.netrc": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "credentials.json": "deny",
      "**/credentials.json": "deny",
      "service-account*.json": "deny",
      "**/service-account*.json": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "~/.local/share/opencode/auth.json": "deny",
      "**/.local/share/opencode/auth.json": "deny",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      ".npmrc": "deny",
      "**/.npmrc": "deny",
      ".git-credentials": "deny",
      "**/.git-credentials": "deny",
      ".aws/**": "deny",
      "**/.aws/**": "deny",
      ".azure/**": "deny",
      "**/.azure/**": "deny",
      ".config/gcloud/**": "deny",
      "**/.config/gcloud/**": "deny",
      ".config/gh/**": "deny",
      "**/.config/gh/**": "deny",
      ".kube/**": "deny",
      "**/.kube/**": "deny",
      ".docker/config.json": "deny",
      "**/.docker/config.json": "deny",
      ".netrc": "deny",
      "**/.netrc": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "credentials.json": "deny",
      "**/credentials.json": "deny",
      "service-account*.json": "deny",
      "**/service-account*.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "northpace": {
      "description": "Public showcase primary orchestrator",
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "task": {
          "*": "deny",
          "planner": "allow",
          "research-lead": "allow",
          "delivery-lead": "allow",
          "review-lead": "allow",
          "architect": "allow",
          "fullstack-engineer": "allow",
          "ai-product-engineer": "allow",
          "domain-specialist": "allow",
          "creative-producer": "allow",
          "risk-specialist": "allow",
          "verifier": "allow",
          "atomic-code": "allow",
          "atomic-research": "allow",
          "atomic-verification": "allow"
        }
      },
      "prompt": "Act as a bounded primary orchestrator. Create explicit work contracts, delegate only to registered descendants, pass minimal context, require evidence-backed results, independently verify completion, and stop at Human approval or unknown-evidence gates. Do not create a second runtime, scheduler, daemon, hidden state store, permission engine, or model router."
    }
  }
}
