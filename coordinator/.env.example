
# Example only. Node does not automatically load .env files: use PowerShell $env: variables\n# or run Node >=22 with --env-file=coordinator/.env when a local copy exists.
# .env files are git-ignored; this example contains no secrets.
NP_MAX_LOCAL=1
NP_MAX_CLOUD=1
# Optional, exact values from the project's 'models' command:
# NP_LOCAL_MODEL=lmstudio/model-id
# NP_CLOUD_MODEL=openai/model-id
NP_ALLOW_CLOUD=0
# Use loopback HTTP or HTTPS when OPENCODE_TOKEN/OPENCODE_PASSWORD is set.
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_TOKEN=your-server-auth-token
# Or use OpenCode HTTP Basic Auth (username defaults to opencode):
# OPENCODE_PASSWORD=your-server-password
# OPENCODE_SERVER_USERNAME=opencode
