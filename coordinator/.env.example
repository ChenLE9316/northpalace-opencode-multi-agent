
# COPY TO coordinator/.env OR set these variables in the Windows process.
# .env files are git-ignored; this example contains no secrets.
NP_MAX_LOCAL=1
NP_MAX_CLOUD=1
# Optional, exact values from the project's 'models' command:
# NP_LOCAL_MODEL=lmstudio/model-id
# NP_CLOUD_MODEL=openai/model-id
NP_ALLOW_CLOUD=0
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_TOKEN=your-server-auth-token
