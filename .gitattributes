# Windows-safe newline governance: normalize text to LF on checkout/commit.
* text=auto eol=lf

# Common binary formats: keep as binary, never normalize line endings or diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
