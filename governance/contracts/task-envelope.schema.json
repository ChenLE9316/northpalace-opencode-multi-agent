{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/northpalace/task-envelope.schema.json",
  "title": "TaskEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal", "domain", "risk", "scope", "acceptance_criteria", "verification", "stop_conditions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "scope": {"type": "array", "items": {"type": "string"}},
    "allowed_tools": {"type": "array", "items": {"type": "string"}, "default": []},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
